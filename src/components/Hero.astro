---
import { profile } from '../data/site';

const bootLines = [
  { t: '> boot sohail.ali --profile=agent-systems', c: 'text-muted' },
  { t: '  ✓ core engine (.NET, 8+ yrs) ... online', c: 'text-green' },
  { t: '  ✓ harness fleet ........... 6 systems', c: 'text-green' },
  { t: '  ✓ agents on duty .............. 17+', c: 'text-green' },
  { t: '  ✓ approval gates ............ armed', c: 'text-amber' },
  { t: '> ready.', c: 'text-fg' },
];
---

<section class="relative mx-auto max-w-6xl px-4 sm:px-6 pt-16 sm:pt-24 pb-16">
  <div class="grid gap-10 lg:grid-cols-[1.25fr_1fr] items-start">
    <div>
      <p class="label mb-5 flex items-center gap-2"><span class="led led-pulse text-green"></span> {profile.role}</p>
      <h1 class="text-[2.4rem] leading-[1.08] sm:text-6xl font-semibold tracking-tight text-fg">
        {profile.name}<span class="text-amber">.</span>
      </h1>
      <p class="mt-5 text-xl sm:text-2xl leading-snug text-fg/90 max-w-2xl">
        I build the harnesses that let <span class="text-amber">AI agents</span> ship real software, <span class="text-green">safely</span>.
      </p>
      <p class="mt-5 max-w-xl text-muted leading-relaxed">{profile.intro}</p>

      <div class="mt-8 flex flex-wrap gap-3 font-mono text-sm">
        <a href="#systems" class="rounded-lg bg-amber px-4 py-2.5 font-medium text-black hover:brightness-110 transition">▸ View systems</a>
        <a href="#pipeline" class="rounded-lg border border-line-strong px-4 py-2.5 text-fg hover:border-amber transition">Watch the pipeline</a>
        <a href="#comms" class="rounded-lg border border-line-strong px-4 py-2.5 text-fg hover:border-amber transition">Open comms</a>
      </div>
    </div>

    <div class="panel overflow-hidden" aria-label="Boot sequence">
      <div class="flex items-center gap-1.5 border-b border-line px-4 py-2.5">
        <span class="h-2.5 w-2.5 rounded-full bg-red/80"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-amber/80"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-green/80"></span>
        <span class="ml-3 font-mono text-[0.7rem] text-dim">~/mission-control</span>
      </div>
      <pre id="boot" class="min-h-[14.5rem] overflow-x-auto p-4 sm:p-5 font-mono text-[0.72rem] sm:text-[0.8rem] leading-7">{bootLines.map((l) => <span class={`boot-line block ${l.c}`}>{l.t}</span>)}<span class="inline-block h-4 w-2 translate-y-0.5 bg-amber animate-pulse"></span></pre>
      <div class="grid grid-cols-3 border-t border-line font-mono text-[0.68rem] text-dim">
        <div class="p-3 border-r border-line"><div class="text-fg text-base">8+</div>years shipping</div>
        <div class="p-3 border-r border-line"><div class="text-fg text-base">3</div>harness gens</div>
        <div class="p-3"><div class="text-fg text-base">130+</div>agent skills</div>
      </div>
    </div>
  </div>
</section>

<script>
  const lines = [...document.querySelectorAll<HTMLElement>('#boot .boot-line')];
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    lines.forEach((l) => (l.style.opacity = '0'));
    lines.forEach((l, i) => setTimeout(() => (l.style.transition = 'opacity .25s', l.style.opacity = '1'), 250 + i * 320));
  }
</script>
