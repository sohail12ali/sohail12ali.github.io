---
import { engagements, rangeEase } from '../data/site';

interface Props { embedded?: boolean }
const { embedded = false } = Astro.props;
---

{embedded ? (
  <div class="not-prose-mc">
    <div class="grid gap-3 md:grid-cols-2">
      {engagements.map((e) => (
        <div class="panel p-5">
          <span class="font-mono text-[0.68rem] text-dim">{e.code}</span>
          <h3 class="mt-1 text-lg font-semibold text-fg">{e.name}</h3>
          <p class="mt-2 text-sm text-muted leading-relaxed">{e.shipped}</p>
          <p class="mt-3 text-sm text-amber leading-relaxed"><span class="font-mono">▸ </span>{e.ease}</p>
          <div class="mt-4 flex flex-wrap gap-1.5">{e.stacks.map((s) => <span class="chip">{s}</span>)}</div>
        </div>
      ))}
    </div>
    <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {rangeEase.map((r) => (
        <div class="panel p-4">
          <div class="font-mono text-[0.68rem] uppercase tracking-wider text-green">{r.k}</div>
          <p class="mt-1.5 text-sm text-muted leading-relaxed">{r.v}</p>
        </div>
      ))}
    </div>
  </div>
) : (
  <section id="range" class="mx-auto max-w-6xl px-4 sm:px-6 py-16">
    <p class="label mb-3 reveal">// Range</p>
    <div class="flex flex-wrap items-end justify-between gap-4 mb-8 reveal">
      <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight">The work the harness carried.</h2>
      <p class="text-muted max-w-md">The fleet is the method. This is what it shipped.</p>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      {engagements.map((e) => (
        <div class="panel p-5 sm:p-6 reveal">
          <span class="font-mono text-[0.68rem] text-dim">{e.code}</span>
          <h3 class="mt-1 text-xl font-semibold text-fg">{e.name}</h3>
          <p class="mt-2 text-sm text-muted leading-relaxed">{e.shipped}</p>
          <p class="mt-3 text-sm text-amber leading-relaxed"><span class="font-mono">▸ </span>{e.ease}</p>
          <div class="mt-4 flex flex-wrap gap-1.5">{e.stacks.map((s) => <span class="chip">{s}</span>)}</div>
        </div>
      ))}
    </div>
    <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {rangeEase.map((r) => (
        <div class="panel p-4 reveal">
          <div class="font-mono text-[0.68rem] uppercase tracking-wider text-green">{r.k}</div>
          <p class="mt-1.5 text-sm text-muted leading-relaxed">{r.v}</p>
        </div>
      ))}
    </div>
  </section>
)}
