---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const notes = (await getCollection('notes')).sort((a, b) => +b.data.date - +a.data.date);
---

<Base title="Field notes" description="Notes on agent harnesses, evals, grounding and local LLMs.">
  <section class="mx-auto max-w-3xl px-4 sm:px-6 pt-12">
    <p class="label mb-3">// Field notes</p>
    <h1 class="text-4xl font-semibold tracking-tight">Notes from the lab.</h1>
    <p class="mt-3 text-muted">Short write-ups on what I learn building agent systems.</p>

    <ul class="mt-10 divide-y divide-line border-y border-line">
      {notes.map((n) => (
        <li>
          <a href={`/notes/${n.id}`} class="group grid gap-1 py-5 sm:grid-cols-[7rem_1fr]">
            <time class="font-mono text-[0.72rem] text-dim pt-1">{n.data.date.toISOString().slice(0, 10)}</time>
            <span>
              <span class="block font-semibold text-fg group-hover:text-amber transition-colors">{n.data.title}</span>
              <span class="block text-sm text-muted mt-1">{n.data.summary}</span>
              <span class="mt-2 flex flex-wrap gap-1.5">{n.data.tags.map((t) => <span class="chip">#{t}</span>)}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
