---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Pipeline from '../components/Pipeline.astro';
import SystemCard from '../components/SystemCard.astro';
import MissionLog from '../components/MissionLog.astro';
import Range from '../components/Range.astro';
import { modules, profile } from '../data/site';

const systems = (await getCollection('systems')).sort((a, b) => a.data.order - b.data.order);
const notes = (await getCollection('notes')).sort((a, b) => +b.data.date - +a.data.date);

const lineage = [
  { gen: 'v1', callsign: 'Genesis', slug: 'genesis', year: '2025', idea: 'Agents leave written artifacts; a human approves every phase.' },
  { gen: 'v2', callsign: 'Mothership', slug: 'mothership', year: '2026', idea: 'Gated pipeline, evidence-backed closure, a console to run it from.' },
  { gen: 'v3', callsign: 'Helmlock', slug: 'helmlock', year: 'next', idea: 'Small kernel, everything else a plugin; delivery and knowledge kept in separate repos.' },
];
---

<Base>
  <Hero />

  <section id="systems" class="mx-auto max-w-6xl px-4 sm:px-6 py-16">
    <p class="label mb-3 reveal">// Systems</p>
    <div class="flex flex-wrap items-end justify-between gap-4 mb-8 reveal">
      <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight">The fleet.</h2>
      <p class="text-muted max-w-md">Agent harnesses, voice layers and grounding systems. Classified work is described by what it does, never who it was for.</p>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      {systems.map((s, i) => <SystemCard system={s} featured={i === 0} />)}
    </div>
  </section>

  <Range />

  <Pipeline />

  <section id="lineage" class="mx-auto max-w-6xl px-4 sm:px-6 py-16 reveal">
    <p class="label mb-3">// Harness lineage</p>
    <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight mb-8">Three generations, one idea: agents need structure.</h2>
    <div class="grid gap-4 md:grid-cols-3 relative">
      {lineage.map((l, i) => (
        <a href={`/systems/${l.slug}`} class="panel p-5 hover:border-amber/70 transition-colors relative">
          <div class="flex items-baseline justify-between font-mono">
            <span class="text-4xl font-semibold text-amber/90">{l.gen}</span>
            <span class="text-[0.7rem] text-dim">{l.year}</span>
          </div>
          <h3 class="mt-3 text-lg font-semibold text-fg">{l.callsign}</h3>
          <p class="mt-1 text-sm text-muted leading-relaxed">{l.idea}</p>
          {i < lineage.length - 1 && <span class="hidden md:block absolute -right-3 top-1/2 -translate-y-1/2 font-mono text-amber z-10">→</span>}
        </a>
      ))}
    </div>
  </section>

  <MissionLog />

  <section id="modules" class="mx-auto max-w-6xl px-4 sm:px-6 py-16">
    <p class="label mb-3 reveal">// Modules loaded</p>
    <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight mb-8 reveal">What's installed.</h2>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {modules.map((m) => (
        <div class="panel p-4 reveal">
          <div class="flex items-center justify-between font-mono text-[0.68rem]">
            <span class="text-amber">BAY-{m.code}</span>
            <span class="flex items-center gap-1.5 text-green"><span class="led"></span>loaded</span>
          </div>
          <h3 class="mt-2 font-semibold text-fg">{m.bay}</h3>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {m.items.map((i) => <span class="chip">{i}</span>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section id="notes" class="mx-auto max-w-6xl px-4 sm:px-6 py-16">
    <p class="label mb-3 reveal">// Field notes</p>
    <div class="flex flex-wrap items-end justify-between gap-4 mb-8 reveal">
      <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight">Notes from the lab.</h2>
      <a href="/notes" class="font-mono text-sm text-muted hover:text-amber">all notes →</a>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {notes.slice(0, 3).map((n) => (
        <a href={`/notes/${n.id}`} class="panel p-5 hover:border-amber/70 transition-colors reveal">
          <time class="font-mono text-[0.68rem] text-dim">{n.data.date.toISOString().slice(0, 10)}</time>
          <h3 class="mt-2 font-semibold text-fg leading-snug">{n.data.title}</h3>
          <p class="mt-2 text-sm text-muted leading-relaxed">{n.data.summary}</p>
        </a>
      ))}
    </div>
  </section>

  <section id="comms" class="mx-auto max-w-6xl px-4 sm:px-6 py-16 reveal">
    <div class="panel relative overflow-hidden p-6 sm:p-10">
      <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(600px 240px at 90% 0%, var(--glow), transparent 70%)"></div>
      <p class="label mb-3 relative">// Comms</p>
      <h2 class="relative text-3xl sm:text-4xl font-semibold tracking-tight max-w-2xl">Building something agents should fly? Let's talk.</h2>
      <p class="relative mt-4 text-muted max-w-xl">{profile.openTo}</p>
      <div class="relative mt-8 flex flex-wrap gap-3 font-mono text-sm">
        {profile.email && (
          <span class="rounded-lg border border-amber/60 px-4 py-2.5 text-amber select-all">{profile.email}</span>
        )}
        <a href={profile.linkedin} target="_blank" rel="noopener" class="rounded-lg bg-amber px-4 py-2.5 font-medium text-black hover:brightness-110">LinkedIn ↗</a>
        <a href={profile.github} target="_blank" rel="noopener" class="rounded-lg border border-line-strong px-4 py-2.5 text-fg hover:border-amber">GitHub ↗</a>
      </div>
      <p class="relative mt-6 font-mono text-[0.72rem] text-dim">{profile.location} · replies are human, not agent-generated</p>
    </div>
  </section>
</Base>
